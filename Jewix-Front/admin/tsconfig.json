{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "/*": ["./*"]
    },
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src/main.tsx",
    "src/test/**/*.ts",
    "src/test/**/*.tsx",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/router/**/*.ts",
    "src/router/**/*.tsx",
    "src/layouts/**/*.ts",
    "src/layouts/**/*.tsx",
    "src/config/**/*.ts",
    "src/config/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "src/.umi",
    "src/.umi-production",
    "src/app.tsx"
  ]
}
